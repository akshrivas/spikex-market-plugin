{
  "manifest_version": 3,
  "name": "Market Radar",
  "version": "4.5.1",
  "description": "SpikeX — Gemini-gated spike trading, expert review, demo trading, Telegram alerts",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.telegram.org/*",
    "https://firestore.googleapis.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.cricway.io/*",
        "*://*.cricway.com/*",
        "*://cricway.io/*",
        "*://cricway.com/*"
      ],
      "js": ["src/bridge-inject.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.cricway.io/*",
        "*://*.cricway.com/*",
        "*://cricway.io/*",
        "*://cricway.com/*"
      ],
      "js": ["src/odds-detect.js", "src/firebase-telegram-config.js", "src/firebase-odds.js", "src/firebase-gemini.js", "src/gemini-review.js", "src/demo-trader.js", "src/market-radar.js"],
      "css": ["styles/panel.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/odds-detect.js", "src/live-board.js"],
      "matches": [
        "*://*.cricway.io/*",
        "*://*.cricway.com/*",
        "*://cricway.io/*",
        "*://cricway.com/*"
      ]
    }
  ]
}
